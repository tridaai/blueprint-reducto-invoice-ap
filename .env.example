# Copy this file to .env in the repo root and fill in only what you use.
# The app loads .env automatically at startup (API, CLI, and demo).
# A variable set in the real environment always takes precedence over .env.
#
# THE STANDARD RUN IS THE REAL REDUCTO PROFILE — that is the
# deployment this blueprint exists to prove: set
# DOCUMENT_BACKEND=reducto, choose a DEPLOYMENT_PROFILE, and add
# your Reducto API key below. The offline adapter is the labelled
# fallback for tests, evals, and no-key smoke runs; it reads the
# synthetic documents' text layer deterministically and is not an
# OCR engine.

# Where the document engine lives: cloud | vpc
DEPLOYMENT_PROFILE=cloud
# Which document backend to use: reducto | offline
DOCUMENT_BACKEND=reducto

# ---------------------------------------------------------------------------
# Reducto (DOCUMENT_BACKEND=reducto)
# ---------------------------------------------------------------------------
# API key from the Reducto dashboard.
REDUCTO_API_KEY=
# Base URL of the Reducto API. Leave unset to take the profile's
# default: https://platform.reducto.ai (cloud) or
# http://reducto-engine:8080 (vpc — the internal endpoint inside
# the customer's boundary). Set it to point the vpc profile at a
# licensed self-hosted engine, or the cloud profile at a regional
# endpoint.
# REDUCTO_BASE_URL=
# Per-request timeout (seconds) for engine calls.
# REDUCTO_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Production data services (set by docker-compose; unset = the
# in-memory test doubles, and /readiness says so)
# ---------------------------------------------------------------------------
# DATABASE_URL=<redacted>
# S3_ENDPOINT_URL=http://minio:8333
# S3_BUCKET=ap-documents
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
